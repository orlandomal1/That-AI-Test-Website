---
/**
 * Dev-only dashboard of outstanding sign-offs. Excluded from the sitemap and noindexed via
 * DEV_ROUTES in lib/seo.ts; removed entirely before launch.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { allKeys, entryOf, isApproved } from '../lib/approvals';
import { routeGates } from '../site.config';

const keys = allKeys();
const gateFor = (key: string) =>
  Object.entries(routeGates).filter(([, k]) => k === key).map(([route]) => route);
---

<BaseLayout title="Approvals" description="Internal: outstanding approvals." noindex>
  <div class="u-container u-container--wide dash">
    <h1>Approvals</h1>
    <p class="dash__lead">
      {keys.filter((k) => !isApproved(k)).length} of {keys.length} pending. Flip <code
        >approved</code
      > in <code>src/site.config.ts</code>.
    </p>

    <table class="dash__table">
      <thead>
        <tr><th>Key</th><th>Status</th><th>Renders now</th><th>Gates</th><th>Note</th></tr>
      </thead>
      <tbody>
        {
          keys.map((key) => {
            const e = entryOf(key);
            const gates = gateFor(key);
            return (
              <tr>
                <td><code>{key}</code></td>
                <td>{e.approved ? 'approved' : 'pending'}</td>
                <td>
                  {e.approved
                    ? e.approvedValue || '(empty)'
                    : e.hideWhenUnapproved
                      ? '(nothing — hidden)'
                      : e.default}
                </td>
                <td>{gates.length ? gates.join(', ') : '—'}</td>
                <td>{e.note ?? ''}</td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
</BaseLayout>

<style>
  .dash {
    padding-block: var(--space-16) var(--section-y);
    display: grid;
    gap: var(--space-6);
  }

  .dash__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
    text-align: start;
  }

  .dash__table :is(th, td) {
    padding: var(--space-3);
    border-block-end: var(--border-width) solid var(--border);
    text-align: start;
    vertical-align: top;
  }

  .dash__table th {
    font-family: var(--font-mono);
    letter-spacing: var(--track-mono);
    color: var(--ink-muted);
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.95em;
  }
</style>
