---
/**
 * The primary call to action. Cyan is reserved for this and for links, per brand guidelines §3
 * and brief §2 — never a background fill anywhere else.
 *
 * Defaults to the booking link from site.config, falling back to mailto: while that is a
 * placeholder.
 */
import { ctaHref } from '../site.config';

interface Props {
  label?: string;
  href?: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const {
  label = 'Book a call',
  href = ctaHref(),
  variant = 'primary',
  class: className,
} = Astro.props;
---

<a href={href} class:list={['cta', `cta--${variant}`, className]}>
  <span>{label}</span>
</a>

<style>
  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    border-radius: var(--radius-md);
    border: var(--border-width) solid transparent;
    /* Brief §9: animate transform and opacity only, never transition-all. */
    transition:
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .cta--primary {
    background: var(--accent);
    color: var(--surface);
  }

  .cta--primary:hover {
    background: var(--accent-deep);
    color: var(--surface);
  }

  .cta--secondary {
    background: transparent;
    color: var(--ink);
    border-color: var(--border-strong);
  }

  .cta--secondary:hover {
    color: var(--accent);
    border-color: var(--border-accent);
  }

  .cta:active {
    transform: translateY(1px);
  }
</style>
