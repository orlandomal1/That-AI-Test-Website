---
/**
 * The proof-strip card. Brief §7: "client descriptor, one-line problem, one-line result, link."
 * Used on / and, at larger size, on /work.
 */
import { interpolate, type TokenContext } from '../lib/approvals';

interface Props {
  href: string;
  descriptor: string;
  problem: string;
  result: string;
  ctx: TokenContext;
  size?: 'default' | 'large';
}

const { href, descriptor, problem, result, ctx, size = 'default' } = Astro.props;
---

<a href={href} class:list={['card', `card--${size}`]}>
  <p class="card__descriptor u-label">{interpolate(descriptor, ctx)}</p>
  <p class="card__problem">{interpolate(problem, ctx)}</p>
  <p class="card__result">{interpolate(result, ctx)}</p>
  <span class="card__link" aria-hidden="true">Read the case study &rarr;</span>
</a>

<style>
  .card {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-8);
    background: var(--surface-2);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .card:hover {
    border-color: var(--border-accent);
    transform: translateY(-2px);
  }

  .card__problem {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    line-height: var(--lead-snug);
    letter-spacing: var(--track-snug);
    color: var(--ink);
    text-wrap: balance;
  }

  .card--large .card__problem {
    font-size: var(--step-3);
  }

  .card__result {
    font-size: var(--step-0);
    color: var(--ink-dim);
  }

  .card__link {
    margin-block-start: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--track-mono);
    color: var(--accent);
  }

  .card:hover .card__link {
    color: var(--accent-deep);
  }
</style>
